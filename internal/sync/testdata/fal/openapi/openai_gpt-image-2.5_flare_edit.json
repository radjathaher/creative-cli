{
  "openapi": "3.0.4",
  "paths": {
    "/openai/gpt-image-2.5/flare/edit": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GptImage25FlareEditInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GptImage25FlareEditInput": {
        "description": "GPT Image 2.5 edit inputs with model-specific quality and compression.",
        "required": [
          "prompt",
          "image_urls"
        ],
        "properties": {
          "image_urls": {
            "description": "The URLs of the images to use as a reference for the generation. A maximum of 16 images are allowed.",
            "items": {
              "type": "string"
            },
            "maxItems": 16,
            "title": "Image URLs",
            "type": "array"
          },
          "mask_url": {
            "description": "The URL of the mask image to use for the generation. This indicates what part of the image to edit.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mask URL"
          },
          "enable_safety_checker": {
            "description": "Authorized callers may set false to request relaxed screening.",
            "default": true,
            "title": "Enable Safety Checker",
            "type": "boolean"
          },
          "image_size": {
            "description": "The size of the generated image. Use 'auto' to infer from input images.",
            "default": "auto",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImageSize"
              },
              {
                "type": "string",
                "enum": [
                  "square_hd",
                  "square",
                  "portrait_4_3",
                  "portrait_16_9",
                  "landscape_4_3",
                  "landscape_16_9",
                  "auto"
                ]
              }
            ],
            "title": "Image Size"
          },
          "quality": {
            "description": "Quality for the generated image. Higher settings increase detail, latency, and token usage. Use 'auto' to let the model choose.",
            "type": "string",
            "default": "high",
            "title": "Quality",
            "enum": [
              "auto",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "num_images": {
            "maximum": 10,
            "default": 1,
            "minimum": 1,
            "description": "Number of images to generate",
            "type": "integer",
            "title": "Number of Images"
          },
          "background": {
            "description": "Background for the generated image",
            "default": "auto",
            "type": "string",
            "title": "Background",
            "enum": [
              "auto",
              "transparent",
              "opaque"
            ]
          },
          "output_format": {
            "description": "Output format for the images",
            "default": "png",
            "type": "string",
            "title": "Output Format",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ]
          },
          "output_compression": {
            "description": "Compression level from 0 to 100. Only supported when output_format is 'jpeg' or 'webp'.",
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Compression"
          },
          "sync_mode": {
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
            "default": false,
            "title": "Sync Mode",
            "type": "boolean"
          },
          "prompt": {
            "description": "The prompt for image generation",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          }
        },
        "type": "object",
        "x-fal-order-properties": [
          "prompt",
          "image_urls",
          "mask_url",
          "image_size",
          "background",
          "quality",
          "num_images",
          "output_format",
          "output_compression",
          "sync_mode",
          "enable_safety_checker"
        ],
        "title": "GPTImage25EditImageRequest"
      },
      "ImageSize": {
        "type": "object",
        "properties": {
          "width": {
            "maximum": 14142,
            "default": 512,
            "description": "The width of the generated image.",
            "type": "integer",
            "title": "Width",
            "exclusiveMinimum": 0
          },
          "height": {
            "maximum": 14142,
            "default": 512,
            "description": "The height of the generated image.",
            "type": "integer",
            "title": "Height",
            "exclusiveMinimum": 0
          }
        },
        "x-fal-order-properties": [
          "width",
          "height"
        ],
        "title": "ImageSize"
      },
      "ImageFile": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "content_type": {
            "description": "The mime type of the file.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          },
          "width": {
            "description": "The width of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          },
          "file_size": {
            "description": "The size of the file in bytes.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size"
          },
          "url": {
            "description": "The URL where the file can be downloaded from.",
            "title": "Url",
            "type": "string"
          },
          "height": {
            "description": "The height of the image",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "file_name": {
            "description": "The name of the file. It will be auto-generated if not provided.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name"
          }
        },
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size",
          "width",
          "height"
        ],
        "title": "ImageFile"
      }
    }
  }
}
