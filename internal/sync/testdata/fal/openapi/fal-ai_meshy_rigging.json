{
  "openapi": "3.0.4",
  "paths": {
    "/fal-ai/meshy/rigging": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeshyRiggingInput"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MeshyRiggingInput": {
        "type": "object",
        "title": "RiggingInput",
        "description": "Input for standalone auto-rigging and animation of a 3D model",
        "properties": {
          "enable_animation": {
            "type": "boolean",
            "default": false,
            "description": "Apply an animation preset to the rigged model.",
            "title": "Enable Animation"
          },
          "enable_safety_checker": {
            "type": "boolean",
            "default": true,
            "description": "If set to true, input data will be checked for safety before processing.",
            "title": "Enable Safety Checker"
          },
          "height_meters": {
            "type": "number",
            "default": 1.7,
            "description": "Approximate height of the character in meters.",
            "exclusiveMinimum": 0,
            "title": "Height Meters"
          },
          "model_url": {
            "type": "string",
            "description": "URL of a 3D model in GLB format to rig. Can be any publicly accessible URL — works with models generated by Hunyuan, Trellis, Meshy, or any other 3D generation tool. The model must be a humanoid character with clearly defined limbs.",
            "minLength": 1,
            "title": "Model Url"
          },
          "animation_action_id": {
            "type": "integer",
            "description": "Animation preset ID from Meshy's library. Only used when enable_animation is true; in that case it must be in [0, 696] (``0`` is the \"Idle\" preset) and is otherwise rejected with a 422. See https://docs.meshy.ai/en/api/animation-library for available action IDs.",
            "default": 92,
            "title": "Animation Action Id"
          }
        },
        "required": [
          "model_url"
        ],
        "x-fal-order-properties": [
          "model_url",
          "height_meters",
          "enable_animation",
          "animation_action_id",
          "enable_safety_checker"
        ]
      },
      "File": {
        "type": "object",
        "title": "File",
        "properties": {
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name",
            "description": "The name of the file. It will be auto-generated if not provided."
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type",
            "description": "The mime type of the file."
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "The URL where the file can be downloaded from."
          },
          "file_size": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Size",
            "description": "The size of the file in bytes."
          }
        },
        "required": [
          "url"
        ],
        "x-fal-order-properties": [
          "url",
          "content_type",
          "file_name",
          "file_size"
        ]
      },
      "BasicAnimations": {
        "type": "object",
        "title": "BasicAnimations",
        "description": "Basic animation files included with the rigging result",
        "properties": {
          "running_armature_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Running armature only in GLB format"
          },
          "walking_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Walking animation in GLB format"
          },
          "running_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Running animation in GLB format"
          },
          "walking_fbx": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Walking animation in FBX format"
          },
          "walking_armature_glb": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Walking armature only in GLB format"
          },
          "running_fbx": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/File"
              },
              {
                "type": "null"
              }
            ],
            "description": "Running animation in FBX format"
          }
        },
        "x-fal-order-properties": [
          "walking_glb",
          "walking_fbx",
          "walking_armature_glb",
          "running_glb",
          "running_fbx",
          "running_armature_glb"
        ]
      }
    }
  }
}
